/*
  # Deny clickjacking
  X-Frame-Options: DENY

  # Prevent MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Limit referrer information sent to third parties
  Referrer-Policy: strict-origin-when-cross-origin

  # Force HTTPS for 1 year; include subdomains
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Disable browser features not used by the app
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://js.stripe.com")

  # Content Security Policy
  # - script-src: only same-origin bundles (Vite output in /assets/)
  # - style-src: same-origin + unsafe-inline required for Tailwind's runtime styles
  # - img-src: same-origin, inline data URIs, Pexels stock photos, bolt.new OG image
  # - connect-src: Supabase HTTP + WebSocket (realtime), Stripe API
  # - frame-src: Stripe payment iframe
  # - font-src: same-origin only (no external fonts)
  # - object-src / base-uri: locked down to block plugin injection and base-tag hijacking
  # - form-action: same-origin only to prevent form exfiltration
  # - upgrade-insecure-requests: rewrite http:// sub-resource loads to https:// in production
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.pexels.com https://bolt.new; connect-src 'self' https://ofvwzcdnhtnvncuxojwc.supabase.co wss://ofvwzcdnhtnvncuxojwc.supabase.co https://api.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
